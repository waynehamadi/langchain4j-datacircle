<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.waynehamadi</groupId>
    <artifactId>langchain4j-datacircle</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>Datacircle tools for LangChain4j</name>
    <description>Four LangChain4j tools on Datacircle's open API (https://api.datacircle.dev/v1), no key: list the GTM APIs, get one API's best plans, search the plans, get a provider's ranks.</description>
    <url>https://datacircle.dev</url>

    <licenses>
        <license>
            <name>MIT</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Wayne Hamadi</name>
            <email>wayne@datacircle.dev</email>
            <organization>Datacircle</organization>
            <organizationUrl>https://datacircle.dev</organizationUrl>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/waynehamadi/langchain4j-datacircle</url>
        <connection>scm:git:https://github.com/waynehamadi/langchain4j-datacircle.git</connection>
    </scm>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <!-- LangChain4j names each tool's arguments from the method's parameter names. -->
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Built on the oldest LangChain4j it runs on; the tests take -Dlangchain4j.version=... -->
        <langchain4j.version>1.0.0</langchain4j.version>
        <junit.version>5.13.4</junit.version>
    </properties>

    <dependencies>
        <!-- The app's own LangChain4j, 1.0.0 or later. -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-core</artifactId>
            <version>${langchain4j.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
            <version>${langchain4j.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
